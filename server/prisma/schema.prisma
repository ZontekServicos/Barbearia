// ErickCorttes Barbearia — usuários, autenticação por telefone + senha,
// agenda e auditoria administrativa.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// A URL de conexão vive em prisma.config.ts (Migrate) e no driver adapter
// (runtime) — o Prisma 7 não aceita mais `url` aqui.
datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  fullName        String?    @map("full_name") @db.VarChar(120)
  /// Sempre em E.164 (ex.: +5571999999999). Único: um telefone = um usuário.
  phone           String     @unique @db.VarChar(20)
  role            UserRole   @default(CUSTOMER)
  status          UserStatus @default(PENDING)
  /// Argon2id. Nulo = conta herdada do fluxo OTP, sem credencial estabelecida.
  /// Enquanto for nulo o login por senha é recusado (ver auth.service).
  passwordHash      String?   @map("password_hash") @db.VarChar(255)
  /// Marca a última troca de senha; sessões anteriores a ela são revogadas.
  passwordUpdatedAt DateTime? @map("password_updated_at")
  /// Freio durável contra força bruta, independente de IP e de réplica.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  /// Preenchido apenas pelas contas que verificaram o telefone por SMS antes
  /// da migração. Sem canal de verificação, nada mais o preenche.
  phoneVerifiedAt DateTime?  @map("phone_verified_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  contactHandles  PublicContactHandle[]
  refreshTokens   RefreshToken[]
  appointments    Appointment[]
  actionsPerfomed AdminAuditLog[] @relation("AdminActor")
  actionsReceived AdminAuditLog[] @relation("AdminTarget")

  @@index([status])
  @@index([role])
  @@map("users")
}

/// Refresh token rotativo. Guardamos apenas o hash SHA-256 do token emitido.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  /// Preenchido quando o token é rotacionado, permitindo detectar reuso.
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacement  RefreshToken?  @relation("RefreshRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  predecessors RefreshToken[] @relation("RefreshRotation")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Serviço oferecido pela barbearia.
model Service {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(80)
  description     String   @default("") @db.VarChar(240)
  /// Dinheiro em centavos: inteiro exato, sem ponto flutuante.
  priceCents      Int      @map("price_cents")
  durationMinutes Int      @map("duration_minutes")
  /// Reservados para preparação/limpeza futuras. CHECK no PostgreSQL exige 0
  /// até que a exclusão cubra também os buffers. API/UI não os configuram.
  bufferBeforeMinutes Int  @default(0) @map("buffer_before_minutes")
  bufferAfterMinutes  Int  @default(0) @map("buffer_after_minutes")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  appointments Appointment[]

  @@index([active])
  @@map("services")
}

/// Horário de funcionamento semanal. Uma linha por dia da semana (0 = domingo).
///
/// Os minutos são hora local da barbearia (ver SHOP_TIMEZONE), não UTC: "abre
/// às 9h" continua sendo 9h independentemente de fuso ou horário de verão.
model BusinessHours {
  id                String   @id @default(uuid()) @db.Uuid
  /// 0 = domingo ... 6 = sábado
  weekday           Int      @unique
  closed            Boolean  @default(false)
  openMinute        Int      @map("open_minute")
  closeMinute       Int      @map("close_minute")
  /// Intervalo opcional (almoço). Ambos nulos = sem intervalo.
  breakStartMinute  Int?     @map("break_start_minute")
  breakEndMinute    Int?     @map("break_end_minute")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("business_hours")
}

/// Bloqueio administrativo da agenda (folga, compromisso, manutenção).
model ScheduleBlock {
  id        String   @id @default(uuid()) @db.Uuid
  startsAt  DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime @map("ends_at") @db.Timestamptz(3)
  reason    String   @db.VarChar(160)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([startsAt, endsAt])
  @@map("schedule_blocks")
}

enum AppointmentStatus {
  /// Solicitação pública aguardando confirmação do barbeiro. Segura o horário.
  PENDING
  /// Aprovada pelo barbeiro, aguardando o pagamento do cliente. Segura o
  /// horário até `pendingExpiresAt` — a janela de pagamento. Estado do
  /// AGENDAMENTO; o estado do dinheiro vive em `Payment.status`.
  AWAITING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  /// Recusada pelo barbeiro.
  REJECTED
  /// Pendente que passou do prazo sem resposta; o horário volta a ser livre.
  EXPIRED
}

/// Agendamento. Um barbeiro nesta fase, então a exclusão de sobreposição é global.
///
/// A proteção contra reserva dupla é uma EXCLUDE constraint no PostgreSQL
/// (ver migration): duas transações concorrentes não conseguem gravar dois
/// CONFIRMED sobrepostos, mesmo commitando ao mesmo tempo.
model Appointment {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  serviceId String            @map("service_id") @db.Uuid
  startsAt  DateTime          @map("starts_at") @db.Timestamptz(3)
  /// Fim do ATENDIMENTO — é o que o cliente vê. Nunca inflado.
  endsAt    DateTime          @map("ends_at") @db.Timestamptz(3)
  /// Fim da RESERVA OPERACIONAL: max(grade, duração + buffers) a partir do
  /// início. É este intervalo que a EXCLUDE protege, porque é ele que a
  /// agenda realmente consome. Sempre >= endsAt.
  reservedEndsAt DateTime     @map("reserved_ends_at") @db.Timestamptz(3)
  status    AppointmentStatus @default(CONFIRMED)
  notes     String?           @db.VarChar(280)

  /// Digest SHA-256 do token aleatório entregue a quem criou a solicitação pública.
  /// É a única forma de consultar o próprio pedido sem sessão — telefone não
  /// é credencial e nunca dá acesso a reserva nenhuma.
  publicToken String? @unique @map("public_token") @db.VarChar(64)
  /// Quando uma solicitação PENDING deixa de segurar o horário.
  pendingExpiresAt DateTime? @map("pending_expires_at") @db.Timestamptz(3)
  /// Quem confirmou ou recusou, e quando.
  decidedAt   DateTime? @map("decided_at") @db.Timestamptz(3)

  /// Referência curta que o cliente pode dizer em voz alta ("EC-7F3K2Q").
  /// Existe para a mensagem do WhatsApp e para o balcão NÃO precisarem do
  /// publicToken, que é credencial de consulta e não pode circular.
  publicReference String? @unique @map("public_reference") @db.VarChar(16)

  /// Congelados no momento da reserva: alterar o preço do serviço depois não
  /// pode reescrever o histórico de quem já agendou.
  serviceName       String @map("service_name") @db.VarChar(80)
  servicePriceCents Int    @map("service_price_cents")
  /// Buffers congelados junto com nome e preço: mudar a configuração do
  /// serviço depois não pode reescrever o espaço que esta reserva ocupa.
  bufferBeforeMinutes Int  @default(0) @map("buffer_before_minutes")
  bufferAfterMinutes  Int  @default(0) @map("buffer_after_minutes")

  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  payment Payment?

  @@index([startsAt])
  @@index([userId, startsAt])
  @@index([status, startsAt])
  @@index([status, pendingExpiresAt])
  @@map("appointments")
}

/// Trilha de auditoria das ações administrativas (aprovar, bloquear, reativar, promover).
model AdminAuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String   @map("actor_id") @db.Uuid
  targetUserId String?  @map("target_user_id") @db.Uuid
  action       String   @db.VarChar(60)
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  actor      User  @relation("AdminActor", fields: [actorId], references: [id], onDelete: Restrict)
  targetUser User? @relation("AdminTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
  @@map("admin_audit_logs")
}

/// Capacidade opaca de cadastro: uso único, sem autenticação.
model PublicContactHandle {
  tokenHash String @id @map("token_hash") @db.VarChar(64)
  userId String @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
  @@map("public_contact_handles")
}

/// Contadores compartilhados entre réplicas. Chaves pessoais são HMAC.
model PublicBookingQuota {
  key String @id @db.VarChar(96)
  count Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  @@index([expiresAt])
  @@map("public_booking_quotas")
}

// ---------------------------------------------------------------------------
// Pagamento
//
// Estado do DINHEIRO, deliberadamente separado do estado do AGENDAMENTO. Um
// pagamento recusado não apaga a reserva, e uma reserva cancelada não reescreve
// o histórico financeiro. A transição final para CONFIRMED exige os dois:
// aprovação do barbeiro E `Payment.status = PAID`.
// ---------------------------------------------------------------------------

enum PaymentStatus {
  /// Cobrança criada no provedor, ainda não paga.
  PENDING
  /// Confirmada PELO BACKEND a partir da notificação do provedor. Nunca a
  /// partir de redirect, query string ou botão "já paguei".
  PAID
  /// Provedor recusou.
  FAILED
  /// Janela de pagamento venceu sem confirmação. O horário é liberado.
  EXPIRED
  /// Cancelada junto com a reserva.
  CANCELED
}

enum PaymentMode {
  /// Cobra o valor inteiro do serviço.
  FULL
  /// Cobra um sinal: percentual ou valor fixo, conforme a configuração.
  DEPOSIT
}

model Payment {
  id            String @id @default(uuid()) @db.Uuid
  appointmentId String @unique @map("appointment_id") @db.Uuid
  /// Nome do adaptador que criou a cobrança ("manual", "mercadopago", ...).
  provider          String  @db.VarChar(40)
  /// Identificador da cobrança NO provedor. Usado para conferir a notificação.
  providerPaymentId String? @map("provider_payment_id") @db.VarChar(120)
  mode              PaymentMode
  /// Em centavos, calculado no servidor a partir de Service.priceCents.
  /// O valor enviado pelo navegador nunca é considerado.
  amountCents Int           @map("amount_cents")
  currency    String        @default("BRL") @db.VarChar(3)
  status      PaymentStatus @default(PENDING)
  /// Fim da janela de pagamento. Espelha `Appointment.pendingExpiresAt`.
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  paidAt    DateTime? @map("paid_at") @db.Timestamptz(3)
  /// Dados de checkout devolvidos pelo provedor — endereço público e código
  /// Pix copia-e-cola. Nunca token, segredo ou credencial do provedor.
  checkoutUrl String? @map("checkout_url") @db.VarChar(500)
  pixQrCode   String? @map("pix_qr_code")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  appointment Appointment           @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  events      PaymentWebhookEvent[]

  /// Uma cobrança do provedor corresponde a no máximo um registro nosso.
  @@unique([provider, providerPaymentId])
  @@index([status, expiresAt])
  @@map("payments")
}

/// Notificação de provedor já processada.
///
/// A unicidade (provider, externalId) é o que torna o webhook IDEMPOTENTE: a
/// mesma notificação reenviada dez vezes grava uma linha e é descartada nas
/// outras nove, dentro da transação que aplica o efeito.
model PaymentWebhookEvent {
  id         String   @id @default(uuid()) @db.Uuid
  provider   String   @db.VarChar(40)
  externalId String   @map("external_id") @db.VarChar(200)
  paymentId  String?  @map("payment_id") @db.Uuid
  /// Resultado do processamento, para auditoria de notificação fora de ordem.
  outcome    String   @db.VarChar(40)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, externalId])
  @@index([paymentId])
  @@map("payment_webhook_events")
}
