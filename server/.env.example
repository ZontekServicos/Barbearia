# ---------------------------------------------------------------------------
# ErickCorttes Barbearia — backend
# Copie para .env e preencha. NUNCA versione o .env real.
# ---------------------------------------------------------------------------

# Ambiente: development | test | production
NODE_ENV=development

# Porta do servidor HTTP
PORT=3333

# PostgreSQL (obrigatório)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/erickcorttes?schema=public

# Origem(ns) do frontend autorizada(s) no CORS. Separe múltiplas por vírgula.
FRONTEND_URL=http://localhost:8443

# Segredo que assina o access JWT (obrigatório). Refresh é opaco, não é JWT.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Mínimo 32 caracteres aleatórios.
JWT_ACCESS_SECRET=

# Tempo de vida das credenciais
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Autenticação
#
# O login é telefone + senha. Não há OTP, SMS nem provedor externo: nenhuma
# variável de terceiros é necessária para autenticar.
#
# Senhas usam Argon2id (m=19 MiB, t=2, p=1). Os parâmetros ficam no código,
# em server/src/modules/auth/password.service.ts — não são configuráveis por
# ambiente, para que ninguém enfraqueça o hashing via painel de deploy.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Bootstrap do primeiro administrador
# Usado somente pelo script `pnpm bootstrap:admin`. Remova depois de executar.
# ---------------------------------------------------------------------------
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_NAME=
# Senha do primeiro administrador. Defina no shell, execute o script e remova.
# Nunca versione este valor nem o deixe salvo no Railway.
BOOTSTRAP_ADMIN_PASSWORD=

# Ajuste apenas conforme a cadeia real de proxies confiáveis do deployment.
TRUST_PROXY_HOPS=0
# Use none somente para frontend/API em sites diferentes, ambos HTTPS.
REFRESH_COOKIE_SAME_SITE=lax
# Necessário para promover/reativar registro existente via bootstrap.
BOOTSTRAP_ADMIN_ALLOW_PROMOTION=false
# Necessário para SUBSTITUIR a senha de um admin que já tem credencial.
BOOTSTRAP_ADMIN_RESET_PASSWORD=false

# Caminho público do refresh: /api/auth quando um proxy remove o prefixo /api.
REFRESH_COOKIE_PATH=/auth

# ---------------------------------------------------------------------------
# Pagamento (opcional)
#
# SEM PAYMENT_PROVIDER o pagamento fica DESLIGADO e o comportamento é o
# anterior: aprovar uma solicitação a confirma direto. Nada quebra por deixar
# estas variáveis vazias.
#
# Com provedor configurado, aprovar leva a AWAITING_PAYMENT e a confirmação
# passa a depender da notificação validada do provedor.
#
# 'manual' é adaptador de TESTE — não move dinheiro e é RECUSADO em produção
# (o processo morre na inicialização). Provedores reais com Pix podem ser
# conectados implementando PaymentProvider; ver
# server/src/modules/payment/payment.registry.ts.
# ---------------------------------------------------------------------------

# manual (apenas dev/test) — vazio = pagamento desligado
PAYMENT_PROVIDER=

# Segredo que autentica a notificação (webhook) do provedor. Obrigatório
# sempre que PAYMENT_PROVIDER estiver preenchido. Mínimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# WhatsApp da barbearia (opcional)
#
# Destino do botão "Confirmar pelo WhatsApp", oferecido apenas depois de o
# agendamento estar CONFIRMED. Formato internacional E.164.
# Vazio = o botão não é oferecido. O número do cliente NUNCA define o destino.
# ---------------------------------------------------------------------------
BARBERSHOP_WHATSAPP_NUMBER=

# ---------------------------------------------------------------------------
# Pix estático da barbearia (opcional)
#
# Recebimento MANUAL: o cliente paga e alguém da barbearia confere o extrato e
# confirma pelo painel. Não há confirmação automática — só o provedor dá isso.
#
# Preenchendo estas três variáveis, o pagamento passa a ser exigido para
# confirmar: aprovar uma solicitação leva a AWAITING_PAYMENT em vez de
# CONFIRMED. Deixe vazias para manter o comportamento sem pagamento.
#
# Com PAYMENT_PROVIDER configurado, o provedor tem PRIORIDADE e estas variáveis
# ficam sem uso: só a cobrança dele pode ser conciliada e confirmada sozinha.
#
# Prefira chave ALEATÓRIA. Telefone, CPF ou e-mail ficam estampados no QR de
# todo mundo que for pagar; a chave aleatória não expõe dado pessoal nenhum.
# As três são obrigatórias em conjunto — o BR Code precisa das três.
# ---------------------------------------------------------------------------
BARBERSHOP_PIX_KEY=
# Máximo 25 caracteres (limite do padrão BR Code)
BARBERSHOP_PIX_RECEIVER_NAME=
# Máximo 15 caracteres (limite do padrão BR Code)
BARBERSHOP_PIX_RECEIVER_CITY=
