# ---------------------------------------------------------------------------
# ErickCorttes Barbearia — backend
# Copie para .env e preencha. NUNCA versione o .env real.
# ---------------------------------------------------------------------------

# Ambiente: development | test | production
NODE_ENV=development

# Porta do servidor HTTP
PORT=3333

# PostgreSQL (obrigatório)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/erickcorttes?schema=public

# Origem(ns) do frontend autorizada(s) no CORS. Separe múltiplas por vírgula.
FRONTEND_URL=http://localhost:8443

# Segredo que assina o access JWT (obrigatório). Refresh é opaco, não é JWT.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Mínimo 32 caracteres aleatórios.
JWT_ACCESS_SECRET=

# Tempo de vida das credenciais
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------------------
# OTP
# ---------------------------------------------------------------------------
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Modo de desenvolvimento do OTP: registra o código no log do servidor em vez
# de enviar SMS. NUNCA é aceito com NODE_ENV=production — o servidor recusa
# iniciar se essa combinação for detectada.
AUTH_OTP_DEV_MODE=false

# ---------------------------------------------------------------------------
# Provider de SMS
# console = imprime o código no terminal, somente com AUTH_OTP_DEV_MODE=true
# twilio  = envio real; obrigatório em produção
# ---------------------------------------------------------------------------
SMS_PROVIDER=console

# Credenciais da Twilio (Console > Account Info). Obrigatórias com SMS_PROVIDER=twilio.
# O Account SID tem o formato AC + 32 hexadecimais.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Remetente: configure UM dos dois. Se ambos existirem, o Messaging Service vence.
# Messaging Service (recomendado: pool de remetentes e compliance). Formato MG + 32 hex.
TWILIO_MESSAGING_SERVICE_SID=
# Número comprado na Twilio, em E.164.
TWILIO_FROM_NUMBER=

# Tempo máximo da chamada HTTP à Twilio, em ms (1000 a 30000).
TWILIO_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Bootstrap do primeiro administrador
# Usado somente pelo script `pnpm bootstrap:admin`. Remova depois de executar.
# ---------------------------------------------------------------------------
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_NAME=

# Ajuste apenas conforme a cadeia real de proxies confiáveis do deployment.
TRUST_PROXY_HOPS=0
# Use none somente para frontend/API em sites diferentes, ambos HTTPS.
REFRESH_COOKIE_SAME_SITE=lax
# Necessário para promover/reativar registro existente via bootstrap.
BOOTSTRAP_ADMIN_ALLOW_PROMOTION=false

# Caminho público do refresh: /api/auth quando um proxy remove o prefixo /api.
REFRESH_COOKIE_PATH=/auth
